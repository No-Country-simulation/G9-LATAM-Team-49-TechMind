---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
---

<Layout title="TechMind - Dashboard">
  <Sidebar />
  <div class="flex-1 flex flex-col md:ml-sidebar-width overflow-hidden h-full relative">
    <Header />
    <main class="flex-1 overflow-y-auto p-md lg:p-lg">
      <div class="max-w-container-max mx-auto space-y-lg">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md">
          <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-md hover:bg-surface-container-low transition-colors duration-200">
            <div class="flex justify-between items-start mb-sm">
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Contents Analyzed</span>
              <span class="material-symbols-outlined text-outline">description</span>
            </div>
            <div class="font-display-lg text-display-lg text-on-surface">-</div>
            <div class="mt-xs flex items-center gap-xs font-label-sm text-label-sm text-on-surface-variant">
              <span>Data not available in API</span>
            </div>
          </div>
          <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-md hover:bg-surface-container-low transition-colors duration-200">
            <div class="flex justify-between items-start mb-sm">
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Topics Detected</span>
              <span class="material-symbols-outlined text-outline">category</span>
            </div>
            <div class="font-display-lg text-display-lg text-on-surface">-</div>
            <div class="mt-xs flex items-center gap-xs font-label-sm text-label-sm text-on-surface-variant">
              <span>Data not available in API</span>
            </div>
          </div>
          <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-md hover:bg-surface-container-low transition-colors duration-200">
            <div class="flex justify-between items-start mb-sm">
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Keywords Extracted</span>
              <span class="material-symbols-outlined text-outline">key</span>
            </div>
            <div class="font-display-lg text-display-lg text-on-surface">-</div>
            <div class="mt-xs flex items-center gap-xs font-label-sm text-label-sm text-on-surface-variant">
              <span>Data not available in API</span>
            </div>
          </div>
          <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-md hover:bg-surface-container-low transition-colors duration-200">
            <div class="flex justify-between items-start mb-sm">
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Avg Confidence</span>
              <span class="material-symbols-outlined text-outline">query_stats</span>
            </div>
            <div class="font-display-lg text-display-lg text-on-surface">-</div>
            <div class="mt-xs flex items-center gap-xs font-label-sm text-label-sm text-on-surface-variant">
              <span>Data not available in API</span>
            </div>
          </div>
        </div>
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-md lg:p-lg flex flex-col gap-md">
           <p class="font-body-md text-on-surface-variant text-center my-xl">The global statistics dashboard requires additional backend endpoints to aggregate data over time. Currently, TechMind processes single analysis requests.</p>
        </div>
      </div>
    </main>
  </div>
</Layout>
