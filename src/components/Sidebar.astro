---
const pathname = Astro.url.pathname;
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

// Solo rutas que existen y tienen contenido real.
//
// "Historial" y "Configuracion" apuntaban a "#": no llevaban a ninguna parte.
// Un enlace muerto en una demo es peor que la ausencia del enlace — invita al
// jurado a hacer clic y a encontrarse con nada. Se retiran hasta que existan.
//
// "Panel de Control" (/dashboard) sigue siendo una plantilla con valores a
// cero. Si no da tiempo a poblarla con datos reales, comenta tambien su linea.
const navItems = [
  { path: "/", icon: "home", label: "Inicio" },
  { path: "/dashboard", icon: "dashboard", label: "Panel de Control" },
  { path: "/analyze", icon: "analytics", label: "Analizar" },
];
---
<nav class="bg-primary-container dark:bg-primary-container text-on-primary dark:text-inverse-primary font-label-md text-label-md fixed left-0 top-0 h-full w-sidebar-width border-r border-outline-variant/10 flex flex-col p-md z-30">
  <div class="mb-lg flex items-center gap-sm px-sm pt-sm">
    <img alt="TechMind Logo" class="w-10 h-10 object-contain rounded-lg bg-white/5 p-1" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDBftmat9SxEPSBKSphwq027hDm5Ch-vq_p5lABlLEMTibxHhOt85SklxGmNjxSuNNLkCiZUxCnf5g9-r-7_FObl8JswhNMKSMPKxt1uj2B46bYp6aRCx98cTzDcmhj6jjeSiVHXXvXZent4DHHs9ScHL4QxLx6Y9PGYsLwGDWIqQslsOwTuHMYlBV6R-pVuWodU_RR1udBsfhxJP68WZZlCzUyRSQkE4OmKaWwfoe89cUDOk-hH5oEHQ"/>
    <div>
      <div class="font-headline-md text-headline-md font-bold text-on-primary">TechMind</div>
      <div class="font-label-sm text-label-sm text-on-primary/70">Plataforma de Análisis</div>
    </div>
  </div>

  <div class="flex flex-col gap-xs mt-md">
    {navItems.map((item) => {
      const isActive = currentPath === item.path || (item.path !== "/" && item.path !== "#" && currentPath.startsWith(item.path));
      const activeClass = isActive ? "bg-white/10 text-white" : "text-on-primary-container/70 hover:text-white hover:bg-white/5";
      
      return (
        <a href={item.path} class={`${activeClass} rounded-lg transition-colors flex items-center gap-md px-md py-sm`}>
          <span class="material-symbols-outlined" data-icon={item.icon}>{item.icon}</span>
          <span>{item.label}</span>
        </a>
      );
    })}
  </div>

  <div class="mt-auto flex flex-col gap-xs px-md py-sm">
    <a href="/docs" target="_blank" rel="noopener"
       class="text-on-primary-container/70 hover:text-white transition-colors flex items-center gap-sm font-label-sm text-label-sm">
      <span class="material-symbols-outlined text-[18px]" data-icon="api">api</span>
      <span>Documentación de la API</span>
    </a>
    <span class="text-on-primary-container/40 font-label-sm text-label-sm">v2.0.0</span>
  </div>
</nav>
