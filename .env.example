# ---------------------------------------------------------------------------
# TechMind — variables de entorno
# Copiar a .env y ajustar.  El .env NO se versiona (esta en .gitignore).
# ---------------------------------------------------------------------------

# --- Servidor ---
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Carga los modelos al arrancar en vez de en la primera peticion.
# Ponlo a 0 para arrancar rapido en desarrollo o en los tests.
PRECARGAR_MODELOS=1

# Raiz de la app: la carpeta que CONTIENE models/ y chroma_db/.
APP_ROOT=/app
MODELS_DIR=/app/models

# --- Frontend ---
# Vacio => el navegador usa rutas relativas y nginx hace de proxy inverso
# hacia la API. Es la configuracion recomendada: todo por el puerto 80.
# Solo definir si el frontend se sirve desde otro host, p. ej.:
#   PUBLIC_API_URL=http://140.238.1.2:8000
PUBLIC_API_URL=

# --- CORS ---
# Con el proxy inverso el origen es el mismo y CORS no interviene, pero se
# mantiene configurado por si alguien llama a la API directamente.
# NUNCA usar "*" en produccion.
CORS_ORIGINS=http://localhost:4321,http://localhost:5173

# ---------------------------------------------------------------------------
# OCI Object Storage — de donde saca el contenedor los artefactos del modelo
# ---------------------------------------------------------------------------
# Si la carpeta models/ ya tiene los seis artefactos, no se descarga nada y
# puedes dejar todo esto vacio.
#
# OPCION A (recomendada para el hackathon): Pre-Authenticated Request.
#   Una URL firmada por OCI, con caducidad. No necesita SDK ni permisos IAM.
#   Crear en la consola: Bucket > Pre-Authenticated Requests > Create.
#   Tipo: "Objects with prefix", permiso de lectura, prefijo paquete/v2.0.0/
#   Pegar aqui la URL COMPLETA que devuelve la consola (termina en el prefijo).
#
#   OJO: el prefijo es paquete/, no models/. El paquete incluye models/,
#   models/modelo_bertopic/ y chroma_db/, mas un manifest.json que enumera
#   todo. Lo genera scripts/preparar_paquete_modelo.py.
OCI_PAR_URL=

# OPCION B (produccion): SDK con Instance Principals.
#   Requiere Dynamic Group + Policy sobre la instancia de Compute.
#   Ver docs/OCI_DEPLOYMENT.md, seccion "Instance Principals".
OCI_NAMESPACE=
OCI_BUCKET=
OCI_PREFIX=paquete/v2.0.0/

# Segundos de espera al descargar cada artefacto.
OCI_TIMEOUT=120
