---
import LandingLayout from '../layouts/LandingLayout.astro';
---
<LandingLayout title="TechMind - Understand technical information with AI">
<div class="flex-grow flex flex-col w-full">
<header class="w-full flex justify-between items-center px-lg py-md border-b border-outline-variant bg-surface-container-lowest z-10 sticky top-0">
  <div class="flex items-center gap-sm">
    <img alt="TechMind Logo" class="h-8 w-8 rounded-DEFAULT object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDBftmat9SxEPSBKSphwq027hDm5Ch-vq_p5lABlLEMTibxHhOt85SklxGmNjxSuNNLkCiZUxCnf5g9-r-7_FObl8JswhNMKSMPKxt1uj2B46bYp6aRCx98cTzDcmhj6jjeSiVHXXvXZent4DHHs9ScHL4QxLx6Y9PGYsLwGDWIqQslsOwTuHMYlBV6R-pVuWodU_RR1udBsfhxJP68WZZlCzUyRSQkE4OmKaWwfoe89cUDOk-hH5oEHQ"/>
    <span class="font-headline-md text-headline-md font-bold text-primary">TechMind</span>
  </div>
  <nav class="hidden md:flex gap-lg">
    <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="#how-it-works">How it works</a>
    <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="#pipeline">Platform</a>
  </nav>
  <div>
    <a href="/analyze" class="bg-primary-container text-on-primary rounded-DEFAULT px-md py-sm font-label-md text-label-md hover:bg-surface-tint transition-colors">Start Analysis</a>
  </div>
</header>
<main class="flex-grow flex flex-col items-center w-full">
  <section class="w-full max-w-container-max px-lg py-xl flex flex-col lg:flex-row items-center justify-between gap-xl min-h-[80vh]">
    <div class="flex-1 flex flex-col items-start gap-md max-w-[672px]">
      <div class="inline-flex items-center gap-xs px-sm py-xs bg-surface-container rounded-full border border-outline-variant">
        <span class="material-symbols-outlined text-[16px] text-primary">auto_awesome</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant">AI-Powered Analysis</span>
      </div>
      <h1 class="font-display-lg text-display-lg md:text-[64px] md:leading-[72px] text-primary mb-sm">
        Understand technical information with AI.
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-md max-w-[576px]">
        TechMind analyzes technical content and transforms complex text into structured topics, keywords, and categories.
      </p>
      <div class="flex gap-md w-full sm:w-auto flex-col sm:flex-row">
        <a href="/analyze" class="bg-primary-container text-on-primary rounded-DEFAULT px-lg py-md font-label-md text-label-md hover:bg-surface-tint transition-colors w-full sm:w-auto text-center">
          Try TechMind
        </a>
        <a href="#how-it-works" class="bg-surface-container-lowest text-primary border border-outline-variant rounded-DEFAULT px-lg py-md font-label-md text-label-md hover:bg-surface-container transition-colors w-full sm:w-auto text-center flex items-center justify-center gap-xs">
          How it works
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
    </div>
    <div class="flex-1 w-full max-w-[576px] relative flex justify-center items-center" id="pipeline">
      <div class="absolute inset-0 bg-gradient-to-tr from-primary-fixed-dim/20 to-transparent rounded-full blur-3xl -z-10"></div>
      <div class="glass-card rounded-xl p-lg w-full flex flex-col gap-md shadow-sm border border-outline-variant bg-surface-container-lowest" style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px);">
        <div class="flex items-center gap-sm p-sm bg-surface-container-low border border-outline-variant rounded-lg">
          <div class="bg-surface-container p-xs rounded-DEFAULT border border-outline-variant flex-shrink-0">
            <span class="material-symbols-outlined text-on-surface-variant">description</span>
          </div>
          <div class="flex-grow">
            <div class="h-2 bg-outline-variant/30 rounded w-3/4 mb-1"></div>
            <div class="h-2 bg-outline-variant/30 rounded w-1/2"></div>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant ml-auto">Technical Text</span>
        </div>
        <div class="flex justify-center -my-2 z-10 relative">
          <div class="bg-surface-container-lowest border border-outline-variant rounded-full p-1 shadow-sm">
            <span class="material-symbols-outlined text-primary text-[20px]">arrow_downward</span>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-sm">
          <div class="flex items-center gap-xs p-sm bg-surface-container-low border border-outline-variant rounded-lg justify-center">
            <span class="material-symbols-outlined text-primary text-[16px]">psychology</span>
            <span class="font-label-sm text-label-sm text-primary">NLP</span>
          </div>
          <div class="flex items-center gap-xs p-sm bg-surface-container-low border border-outline-variant rounded-lg justify-center">
            <span class="material-symbols-outlined text-primary text-[16px]">memory</span>
            <span class="font-label-sm text-label-sm text-primary">AI Models</span>
          </div>
        </div>
        <div class="flex justify-center -my-2 z-10 relative">
          <div class="bg-surface-container-lowest border border-outline-variant rounded-full p-1 shadow-sm">
            <span class="material-symbols-outlined text-primary text-[20px]">arrow_downward</span>
          </div>
        </div>
        <div class="flex gap-xs flex-wrap">
          <div class="flex-1 min-w-[30%] bg-surface-container-low border border-outline-variant rounded-lg p-sm text-center">
            <span class="font-label-sm text-label-sm text-on-surface block mb-1">Topics</span>
            <div class="h-1 bg-primary/20 rounded w-full"></div>
          </div>
          <div class="flex-1 min-w-[30%] bg-surface-container-low border border-outline-variant rounded-lg p-sm text-center">
            <span class="font-label-sm text-label-sm text-on-surface block mb-1">Keywords</span>
            <div class="h-1 bg-primary/20 rounded w-full"></div>
          </div>
          <div class="flex-1 min-w-[30%] bg-surface-container-low border border-outline-variant rounded-lg p-sm text-center">
            <span class="font-label-sm text-label-sm text-on-surface block mb-1">Classification</span>
            <div class="h-1 bg-primary/20 rounded w-full"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="w-full max-w-container-max px-lg py-xl border-t border-outline-variant/30 bg-surface-container-low" id="how-it-works">
    <div class="mb-lg">
      <h2 class="font-headline-lg text-headline-lg text-primary mb-xs">How it works</h2>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-[672px]">The technical pipeline that transforms unstructured data into actionable insights.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-[24px]">
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg flex flex-col gap-sm hover:bg-surface-bright transition-colors md:col-span-2">
        <div class="flex justify-between items-start mb-sm">
          <div class="bg-primary-container text-on-primary rounded-full w-8 h-8 flex items-center justify-center font-label-sm text-label-sm">01</div>
          <span class="material-symbols-outlined text-outline">upload_file</span>
        </div>
        <h3 class="font-headline-md text-headline-md text-primary border-b border-outline-variant pb-2">Input</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Ingest complex technical documents, codebases, or raw research papers. The system supports a wide array of formats for seamless integration.</p>
      </div>
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg flex flex-col gap-md hover:bg-surface-bright transition-colors h-full md:col-span-1 md:row-span-2">
        <div class="flex flex-col gap-sm flex-1 border-b border-outline-variant pb-md mb-md">
          <div class="flex justify-between items-start mb-sm">
            <div class="border border-outline-variant text-on-surface-variant rounded-full w-8 h-8 flex items-center justify-center font-label-sm text-label-sm bg-surface-container">02</div>
            <span class="material-symbols-outlined text-outline">schema</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-primary">NLP Processing</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant">Advanced Natural Language Processing breaks down the text, identifying syntax, entities, and contextual relationships within the technical jargon.</p>
        </div>
        <div class="flex flex-col gap-sm flex-1">
          <div class="flex justify-between items-start mb-sm">
            <div class="border border-outline-variant text-on-surface-variant rounded-full w-8 h-8 flex items-center justify-center font-label-sm text-label-sm bg-surface-container">03</div>
            <span class="material-symbols-outlined text-outline">hub</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-primary">Topic Modeling</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant">AI clusters information to discover latent themes, mapping overarching concepts across extensive datasets without manual tagging.</p>
        </div>
      </div>
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg flex flex-col gap-sm hover:bg-surface-bright transition-colors md:col-span-1">
        <div class="flex justify-between items-start mb-sm">
          <div class="border border-outline-variant text-on-surface-variant rounded-full w-8 h-8 flex items-center justify-center font-label-sm text-label-sm bg-surface-container">04</div>
          <span class="material-symbols-outlined text-outline">key</span>
        </div>
        <h3 class="font-headline-md text-headline-md text-primary border-b border-outline-variant pb-2">Keyword Extraction</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Isolate the most critical terms and phrases, providing immediate visibility into the core subjects discussed.</p>
      </div>
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg flex flex-col gap-sm hover:bg-surface-bright transition-colors md:col-span-1">
        <div class="flex justify-between items-start mb-sm">
          <div class="border border-outline-variant text-on-surface-variant rounded-full w-8 h-8 flex items-center justify-center font-label-sm text-label-sm bg-surface-container">05</div>
          <span class="material-symbols-outlined text-outline">category</span>
        </div>
        <h3 class="font-headline-md text-headline-md text-primary border-b border-outline-variant pb-2">Classification</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Categorize documents into predefined or dynamically generated taxonomies for structured organization and easy retrieval.</p>
      </div>
      <div class="bg-primary-container border border-outline-variant rounded-xl p-lg flex flex-col gap-sm hover:bg-surface-tint transition-colors md:col-span-3">
        <div class="flex justify-between items-start mb-sm">
          <div class="bg-surface-container-lowest text-primary rounded-full w-8 h-8 flex items-center justify-center font-label-sm text-label-sm">06</div>
          <span class="material-symbols-outlined text-on-primary">check_circle</span>
        </div>
        <h3 class="font-headline-md text-headline-md text-on-primary border-b border-on-primary/20 pb-2">Results</h3>
        <p class="font-body-sm text-body-sm text-on-primary/80 max-w-[768px]">Access structured, readable insights via API or our interactive dashboard, turning raw text into quantifiable data ready for analysis.</p>
      </div>
    </div>
  </section>
</main>
<footer class="bg-surface-container-low dark:bg-surface-container-low w-full border-t border-outline-variant flex justify-between items-center px-lg py-sm">
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-xs sm:gap-md">
    <span class="font-label-sm text-label-sm font-bold text-primary">TechMind</span>
    <span class="font-body-sm text-body-sm text-on-surface-variant dark:text-on-surface-variant">© 2026 TechMind Analysis Platform</span>
  </div>
</footer>
</div>
</LandingLayout>
